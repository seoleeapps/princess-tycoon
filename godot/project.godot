; Engine configuration file.
; Runtime contract: Godot 4.6.x, GL Compatibility, portrait mobile.

config_version=5

[application]

config/name="왕립 아카데미"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/max_fps=60
config/quit_on_go_back=false
config/icon="res://assets/android/launcher-192.png"
boot_splash/bg_color=Color(0.227, 0.141, 0.078, 1)
boot_splash/image="res://assets/android/launcher-192.png"
boot_splash/fullsize=false
boot_splash/use_filter=false

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[internationalization]

locale/fallback="ko"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
